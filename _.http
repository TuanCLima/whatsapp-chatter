### Fetch Twilio Messages
GET https://api.twilio.com/2010-04-01/Accounts/[sid]/Messages.json
Authorization: Basic [token]

### Send WhatsApp Message
#POST https://d9miv23p28.execute-api.us-east-1.amazonaws.com/send-message
POST http://localhost:3000/send-message
Content-Type: application/json

{
  "to": "+5511966493808",
  "message": "Hello from Twilio WhatsApp API!"
}

###
// url encoded webhook post
POST http://localhost:3000/webhook
Content-Type: application/x-www-form-urlencoded

From=whatsapp%3A%2B14155239999&To=whatsapp%3A%2B5511999999999&Body=Hello%20from%20Twilio%20WhatsApp%20API%21



### contact card
GET http://localhost:3000/CONTACT_1.vcf


### get mcp functions
GET http://localhost:3000/api/mcp/functions

### get mcp date
POST http://localhost:3001/api/mcp/execute
Content-Type: application/json

{
  "functionName": "getSaoPauloDate",
  "parameters": {}
}

### get events through execute
POST http://localhost:3000/api/mcp/execute
Content-Type: application/json

{
  "functionName": "fetchCalendarEvents",
  "parameters": {
    "timeMin": "2024-01-01T00:00:00Z",
    "timeMax": "2025-12-31T23:59:59Z",
    "maxResults": 10,
    "singleEvents": true,
    "orderBy": "startTime"
  }
}

### Check event cancellation eligibility
POST http://localhost:3000/api/mcp/execute
Content-Type: application/json

{
  "functionName": "checkEventCancellationEligibility",
  "parameters": {
    "eventId": "81g7k00d2oe73eflsmnti07jdc",
    "userPhone": "+5511944444444"
  }
}

### Check and cancel event if eligible
POST http://localhost:3000/api/mcp/execute
Content-Type: application/json

{
  "functionName": "checkAndCancelEventIfEligible",
  "parameters": {
    "eventId": "81g7k00d2oe73eflsmnti07jdc",
    "userPhone": "+5511966666666"
  }
}

### Check event availability
POST http://localhost:3000/api/mcp/execute
Content-Type: application/json

{
  "functionName": "checkEventAvailability",
  "parameters": {
    "proposedStartTime": "2025-08-06T10:30:00-03:00",
    "proposedEndTime": "2025-08-06T12:00:00-03:00",
    "serviceDurationMinutes": 90
  }
}

### Test fetch events
POST http://localhost:3000/api/mcp/fetch-events
Content-Type: application/json

{
    "calendarId": "canlendarId",
    "timeMin": "2025-08-06T00:00:00Z",
    "timeMax": "2025-08-06T23:59:59Z",
    "maxResults": 10,
    "singleEvents": true,
    "orderBy": "startTime"
  }


### Test creating an event
POST http://localhost:3000/api/mcp/create-event
Content-Type: application/json

{
  "event": {
    "summary": "Meeting with Team",
    "location": "123 Main St",
    "description": "Discuss project updates",
    "start": {
      "dateTime": "2025-05-08T13:00:00-03:00",
      "timeZone": "America/Sao_Paulo"
    },
    "end": {
      "dateTime": "2025-05-08T14:00:00-03:00",
      "timeZone": "America/Sao_Paulo"
    },
    "attendees": [
      { "email": "example1@gmail.com" }
    ]
  }
}

