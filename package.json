{
  "name": "chat-webhook",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "auth": "tsx src/scripts/authorize.ts",
    "maintain-token": "tsx src/scripts/maintainToken.ts",
    "dev": "tsx watch src/index.ts",
    "dev:full": "concurrently  \"pnpm db:studio\" \"pnpm dev\" \"cd client && pnpm dev\"",
    "build": "cd client && pnpm install && pnpm build",
    "serve": "tsx src/index.ts",
    "predeploy": "tsx src/scripts/generate-vcf.ts",
    "loadPrompt": "tsx src/scripts/loadPrompt.ts",
    "db:studio": "drizzle-kit studio --port 4983 --host 127.0.0.1",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "^2.1.3",
    "@faker-js/faker": "^9.7.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "wrangler": "^4.7.0"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20250403.0",
    "@libsql/client": "^0.15.8",
    "axios": "^1.8.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.1",
    "drizzle-orm": "^0.44.4",
    "express": "^5.1.0",
    "google-auth-library": "^9.15.1",
    "googleapis": "^148.0.0",
    "http-proxy-middleware": "^3.0.5",
    "moment-timezone": "^0.5.48",
    "openai": "^4.90.0",
    "postgres": "^3.4.7",
    "twilio": "^5.5.1"
  }
}
